# Habib OS — environment template. COMMIT THIS FILE (no secrets/values).
# Copy to .env (gitignored) and fill in real values locally.
# CLAUDE.md hard rule 5: secrets live in .env only, never in committed files.

# amazon.ca seller UUID — resolved via the DataDoe MCP `sellers_and_vendors_list`
# tool and cached here. Never inline this value in source (T-01-01).
AMAZON_CA_SELLER_ID=

# Supabase connection strings — read which-is-which from the Supabase project
# Settings > Database page (do not assume the ports).
#   DIRECT  (port 5432): used by Alembic migrations / DDL (plan 01-02).
#   POOLED  (port 6543, transaction pooler): used by short-lived runtime helpers.
SUPABASE_DB_URL=
SUPABASE_DB_URL_POOLED=
